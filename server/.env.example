PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/virtual_classroom
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# AI / attendance tuning
FACE_MATCH_THRESHOLD=0.52
ATTENDANCE_PRESENT_RATIO=0.75
ATTENDANCE_LATE_GRACE_MINUTES=10
ENGAGEMENT_SAMPLE_INTERVAL_SEC=30
